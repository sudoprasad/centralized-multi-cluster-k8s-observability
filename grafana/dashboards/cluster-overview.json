{
  "annotations": { "list": [] },
  "description": "CMCKO — Cluster Overview: L4 network flows and service topology from Beyla eBPF (no app instrumentation needed)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 Service-to-Service Network Traffic (L4 via eBPF)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(beyla_network_flow_bytes_total{direction=\"request\", k8s_src_namespace=\"demo\", k8s_dst_namespace=\"demo\"}[2m])",
          "legendFormat": "{{k8s_src_owner_name}} → {{k8s_dst_owner_name}}",
          "refId": "A"
        }
      ],
      "title": "Intra-Demo Traffic (bytes/s) — traffic-gen → frontend / backend / auth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "beyla_network_flow_bytes_total{direction=\"request\", k8s_src_namespace=\"demo\", k8s_dst_namespace=\"demo\"}",
          "legendFormat": "→ {{k8s_dst_owner_name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Total Bytes per Destination Service",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "🗺️ Service Dependency Map (request flows)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Source Service" }, "properties": [{ "id": "custom.width", "value": 160 }] },
          { "matcher": { "id": "byName", "options": "Destination Service" }, "properties": [{ "id": "custom.width", "value": 160 }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "sortBy": [{ "desc": true, "displayName": "Total Bytes" }],
        "footer": { "show": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "beyla_network_flow_bytes_total{direction=\"request\", k8s_src_namespace=\"demo\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Service Communication Table (eBPF L4 — no app instrumentation)",
      "type": "table",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "direction": true, "k8s_cluster_name": true },
            "renameByName": {
              "k8s_src_namespace": "Src Namespace",
              "k8s_src_owner_name": "Source Service",
              "k8s_src_owner_type": "Src Type",
              "k8s_dst_namespace": "Dst Namespace",
              "k8s_dst_owner_name": "Destination Service",
              "k8s_dst_owner_type": "Dst Type",
              "Value": "Total Bytes"
            }
          }
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "📈 Cluster-Wide Network Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 19 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(beyla_network_flow_bytes_total{direction=\"request\", k8s_src_namespace=\"demo\"}[2m]))",
          "legendFormat": "Demo outbound bytes/s",
          "refId": "A"
        }
      ],
      "title": "Demo App — Outbound Traffic Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 19 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(beyla_network_flow_bytes_total{direction=\"request\", k8s_src_namespace=\"demo\"})",
          "legendFormat": "Total bytes since start",
          "refId": "A"
        }
      ],
      "title": "Total Demo Traffic (since Beyla start)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 19 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (k8s_src_owner_name) (beyla_network_flow_bytes_total{k8s_src_namespace=\"demo\"}))",
          "legendFormat": "Active services",
          "refId": "A"
        }
      ],
      "title": "Active Services (eBPF-detected)",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["cmcko", "phase0", "beyla", "ebpf", "network"],
  "templating": {
    "list": [
      {
        "current": {},
